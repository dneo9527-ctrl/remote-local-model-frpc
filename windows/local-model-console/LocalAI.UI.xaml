<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="远程模型控制台" Width="1000" Height="740" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#F6F8FB" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#344966"/><Setter Property="BorderBrush" Value="#DCE4F1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#526F97"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,0"/></Style>
  <Style x:Key="StopControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#77869A"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FontSize" Value="11"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="9,0"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF0F1"/><Setter Property="Foreground" Value="#BE4558"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#273B53"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#6C97ED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4EF"/><Setter Property="Foreground" Value="#273B53"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border x:Name="SelectBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#8393A7" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton></Grid></Border>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="#6C97ED"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#F1F5FB"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#EAF1FF"/><Setter Property="Foreground" Value="#2B60C5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1" Padding="26,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="11" Background="#3168E8" Margin="0,0,12,0"><Path Data="M 11,12 L 11,25 M 18,8 L 18,29 M 25,12 L 25,25" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border><StackPanel><TextBlock Text="远程模型控制台" FontSize="22" FontWeight="SemiBold" Foreground="#21364F"/><TextBlock Text="本机模型 · 远程连接" Foreground="#8A98AA" Margin="0,4,0,0" FontSize="11"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#F3F6FA" CornerRadius="12" Padding="11,7" Margin="0,0,14,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderDot" Width="6" Height="6" Fill="#A6B1C1" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="HeaderState" Text="正在检查服务" Foreground="#64778D" FontSize="10" TextWrapping="Wrap" MaxWidth="195" VerticalAlignment="Center"/></StackPanel></Border><Button x:Name="StartButton" Content="一键启动" Height="40" MinWidth="164" Background="#3168E8" BorderBrush="#3168E8" Foreground="White" FontWeight="SemiBold" AutomationProperties.Name="一键启动模型与隧道"/></StackPanel>
  </Grid></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,14,26,10">
   <Border x:Name="Banner" Background="#EEF3FC" CornerRadius="10" Padding="13,10" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BannerText" Text="正在读取本机服务状态…" Foreground="#54708F" TextWrapping="Wrap" FontSize="11"/><ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button x:Name="ResumeButton" Content="补齐启动" Style="{StaticResource LinkButton}" Height="28" Visibility="Collapsed"/><Button x:Name="GlobalStopButton" Content="停止当前服务" Style="{StaticResource StopControl}" Height="28" Visibility="Collapsed"/></StackPanel></Grid></Border>
   <UniformGrid Columns="3" Margin="-5,0,-5,14">
    <Border Background="White" CornerRadius="13" BorderBrush="#E4EAF2" BorderThickness="1" Padding="16,15" Margin="5,0"><StackPanel><Grid><TextBlock Text="Ollama 模型服务" Foreground="#74829A" FontSize="11" VerticalAlignment="Center"/><Button x:Name="StopOllamaButton" Content="停止" HorizontalAlignment="Right" Style="{StaticResource StopControl}" AutomationProperties.Name="停止模型服务" ToolTip="会中断本机与远端问答；点击后需确认。"/></Grid><StackPanel Orientation="Horizontal" Margin="0,12,0,10"><Ellipse x:Name="OllamaDot" Width="7" Height="7" Fill="#B4BECD" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="OllamaState" Text="检查中" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/></StackPanel><Button x:Name="OllamaSettingsButton" Style="{StaticResource LinkButton}" Height="Auto" MinHeight="28" HorizontalContentAlignment="Stretch" Padding="0" ToolTip="设置模型服务端口" AutomationProperties.Name="设置模型服务端口"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OllamaDetail" Text="读取配置中" Foreground="#7D8EA3" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="设置 ›" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#7289A8"/></Grid></Button></StackPanel></Border>
    <Border Background="White" CornerRadius="13" BorderBrush="#E4EAF2" BorderThickness="1" Padding="16,15" Margin="5,0"><StackPanel><Grid><TextBlock Text="frp 远程连接" Foreground="#74829A" FontSize="11" VerticalAlignment="Center"/><Button x:Name="StopButton" Content="停止" HorizontalAlignment="Right" Style="{StaticResource StopControl}" AutomationProperties.Name="停止本项目隧道"/></Grid><StackPanel Orientation="Horizontal" Margin="0,12,0,10"><Ellipse x:Name="TunnelDot" Width="7" Height="7" Fill="#B4BECD" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="TunnelState" Text="检查中" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/></StackPanel><Button x:Name="FrpSettingsButton" Style="{StaticResource LinkButton}" Height="Auto" MinHeight="28" HorizontalContentAlignment="Stretch" Padding="0" ToolTip="设置隧道服务端口" AutomationProperties.Name="设置隧道服务端口"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TunnelDetail" Text="等待读取" Foreground="#7D8EA3" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="设置 ›" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#7289A8"/></Grid></Button></StackPanel></Border>
    <Border Background="White" CornerRadius="13" BorderBrush="#E4EAF2" BorderThickness="1" Padding="16,15" Margin="5,0"><StackPanel><Grid Height="28"><TextBlock Text="Tailscale" Foreground="#74829A" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="系统管理" Foreground="#9AA7B9" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><StackPanel Orientation="Horizontal" Margin="0,12,0,10"><Ellipse x:Name="TsDot" Width="7" Height="7" Fill="#B4BECD" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="TsState" Text="检查中" FontSize="16" FontWeight="SemiBold" Foreground="#243B53"/></StackPanel><Button x:Name="TailscaleInfoButton" Style="{StaticResource LinkButton}" Height="Auto" MinHeight="28" HorizontalContentAlignment="Stretch" Padding="0" ToolTip="查看 Tailscale 连接信息" AutomationProperties.Name="查看 Tailscale 连接信息"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TsDetail" Text="可选辅助连接" Foreground="#7D8EA3" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="详情 ›" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#7289A8"/></Grid></Button></StackPanel></Border>
   </UniformGrid>
   <Grid Margin="0,0,0,10"><TextBlock Text="连接线路" FontSize="15" FontWeight="SemiBold" Foreground="#233854" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ProbeButton" Content="测延迟" Style="{StaticResource LinkButton}"/><Button x:Name="AddRouteButton" Content="＋ 添加线路" Margin="7,0,0,0"/><Button x:Name="EditRouteButton" Content="编辑" Style="{StaticResource LinkButton}" Margin="4,0,0,0"/><Button x:Name="DeleteRouteButton" Content="删除" Style="{StaticResource LinkButton}" Margin="4,0,0,0"/></StackPanel></Grid>
   <Grid Margin="0,0,0,10"><TextBlock x:Name="ProbeHint" Text="本机 → VPS · 读取端口中" Foreground="#8A97AB" FontSize="11"/><TextBlock x:Name="CurrentRoute" Text="配置读取中" HorizontalAlignment="Right" Foreground="#657A98" FontSize="11"/></Grid>
   <ListBox x:Name="RouteList" MinHeight="74" MaxHeight="280" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="VPS线路列表">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" BorderBrush="#DCE4F0" Background="White" BorderThickness="1" Padding="13,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF3FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#93B1EF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#83A7EE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" ToolTip="{Binding Name}"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#233D60" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Region}" Foreground="#93A0B4" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding LocationTip}"><Image Source="{Binding Flag}" Width="25" Height="17" Stretch="Uniform" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding CountryDisplay}" Foreground="#617695" FontSize="12"/><TextBlock Text="{Binding LocationDisplay}" Foreground="#8D9BB1" FontSize="10" MaxWidth="155" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding Address}" FontFamily="Consolas" FontSize="12" Foreground="#587294" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Address}"/>
     <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="Ping/TCP 只表示网络探测，不等于问答可用。"><TextBlock Text="{Binding PingText}" Foreground="{Binding PingColor}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding LatencyText}" Foreground="{Binding LatencyColor}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
     <Button Grid.Column="4" Content="复制配置" Style="{StaticResource LinkButton}" Tag="{Binding}" Margin="6,0,0,0" ToolTip="复制这条线路的 frpc visitor TOML；包含私密连接密钥。" AutomationProperties.Name="复制此线路配置"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="选中线路后应用；复制配置可用于你的其他设备。" Foreground="#8A97AB" FontSize="11" Margin="0,5,0,10"/>
   <Grid><StackPanel Orientation="Horizontal"><Button x:Name="CherryButton" Content="Cherry Studio ↗" Height="32" Margin="0,0,8,0"/><Button x:Name="WebButton" Content="网页聊天 ↗" Height="32"/><Button x:Name="RefreshButton" Content="↻ 刷新" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/></StackPanel><Button x:Name="ModelButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" MaxWidth="285" ToolTip="选择本项目默认模型" AutomationProperties.Name="选择项目默认模型"><TextBlock x:Name="ModelText" Text="默认模型读取中" VerticalAlignment="Center" Foreground="#8A97AB" FontSize="11" MaxWidth="260" TextTrimming="CharacterEllipsis"/></Button></Grid>
   <TextBox x:Name="History" Visibility="Collapsed"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" BorderBrush="#E1E7F1" BorderThickness="0,1,0,0" Background="White" Padding="22,10"><Grid><StackPanel Orientation="Horizontal"><Button x:Name="ConnectionButton" Content="连接信息" Style="{StaticResource LinkButton}"/><TextBlock Text="·" VerticalAlignment="Center" Foreground="#C2CCDA"/><Button x:Name="HistoryButton" Content="日志与记录" Style="{StaticResource LinkButton}"/><TextBlock Text="·" VerticalAlignment="Center" Foreground="#C2CCDA"/><Button x:Name="SettingsButton" Content="设置" Style="{StaticResource LinkButton}"/><Button x:Name="UpdateButton" Content="检查更新 ↗" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="CheckedAt" Text="关窗保留服务 · 1.1.2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#92A0B5"/></Grid></Border>
 </Grid>
</Window>
