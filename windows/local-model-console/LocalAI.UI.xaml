<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="远程模型控制台" Width="1000" Height="760" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#F3F6FB" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#344966"/><Setter Property="BorderBrush" Value="#DCE4F1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#526F97"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,0"/></Style>
  <Style x:Key="StopControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#9C4650"/><Setter Property="Background" Value="#FFF8F8"/><Setter Property="BorderBrush" Value="#F0DDE0"/><Setter Property="FontSize" Value="11"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="9,0"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
  <Border Background="#12203A" Padding="28,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="252"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="LOCAL AI  /  YOUR DEVICES" FontSize="10" FontWeight="Bold" Foreground="#79CBE6" Margin="0,0,0,7"/><TextBlock Text="远程模型控制台" FontSize="26" FontWeight="Bold" Foreground="White"/><TextBlock Text="模型与远程连接，集中管理。" Foreground="#ACBCD5" Margin="0,6,0,0" FontSize="12"/></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="StartButton" Content="一键启动" Height="40" MinWidth="180" Background="#3677F6" BorderBrush="#4A85FA" Foreground="White" FontWeight="Bold" AutomationProperties.Name="一键启动模型与隧道"/><TextBlock x:Name="HeaderState" Text="正在检查服务" Foreground="#BECDE4" FontSize="11" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="250" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,14,26,10">
   <Border x:Name="Banner" Background="#E5EDFA" CornerRadius="9" Padding="13,10" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="BannerText" Text="正在读取本机服务状态…" Foreground="#345379" TextWrapping="Wrap" FontSize="12"/><ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel></Border>
   <UniformGrid Columns="3" Margin="-5,0,-5,14">
    <Border Background="White" CornerRadius="12" Padding="16,14" Margin="5,0"><StackPanel><Grid><TextBlock Text="模型服务 · Ollama" Foreground="#74829A" FontSize="12" VerticalAlignment="Center"/><Button x:Name="StopOllamaButton" Content="停止" HorizontalAlignment="Right" Style="{StaticResource StopControl}" AutomationProperties.Name="停止模型服务" ToolTip="会中断本机与远端问答；点击后需确认。"/></Grid><TextBlock x:Name="OllamaState" Text="检查中" FontSize="23" FontWeight="Bold" Margin="0,7,0,7"/><TextBlock x:Name="OllamaDetail" Text="读取配置中" Foreground="#8591A5" FontSize="11" MinHeight="28" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Padding="16,14" Margin="5,0"><StackPanel><Grid><TextBlock Text="远程连接 · frp STCP" Foreground="#74829A" FontSize="12" VerticalAlignment="Center"/><Button x:Name="StopButton" Content="停止" HorizontalAlignment="Right" Style="{StaticResource StopControl}" AutomationProperties.Name="停止本项目隧道"/></Grid><TextBlock x:Name="TunnelState" Text="检查中" FontSize="23" FontWeight="Bold" Margin="0,7,0,7"/><TextBlock x:Name="TunnelDetail" Text="等待读取" Foreground="#8591A5" FontSize="11" MinHeight="28" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Padding="16,14" Margin="5,0"><StackPanel><Grid Height="28"><TextBlock Text="辅助连接 · Tailscale" Foreground="#74829A" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="系统管理" Foreground="#9AA7B9" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Name="TsState" Text="检查中" FontSize="23" FontWeight="Bold" Margin="0,7,0,7"/><TextBlock x:Name="TsDetail" Text="可选辅助连接" Foreground="#8591A5" FontSize="11" MinHeight="28" TextWrapping="Wrap"/></StackPanel></Border>
   </UniformGrid>
   <Grid Margin="0,0,0,10"><TextBlock Text="VPS 线路" FontSize="16" FontWeight="Bold" Foreground="#233854" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ProbeButton" Content="测延迟" Style="{StaticResource LinkButton}"/><Button x:Name="AddRouteButton" Content="＋ 添加" Margin="7,0,0,0"/><Button x:Name="EditRouteButton" Content="编辑" Margin="7,0,0,0"/><Button x:Name="DeleteRouteButton" Content="删除" Margin="7,0,0,0"/></StackPanel></Grid>
   <Grid Margin="0,0,0,10"><TextBlock x:Name="ProbeHint" Text="本机 → VPS · 读取端口中" Foreground="#8A97AB" FontSize="11"/><TextBlock x:Name="CurrentRoute" Text="配置读取中" HorizontalAlignment="Right" Foreground="#657A98" FontSize="11"/></Grid>
   <ListBox x:Name="RouteList" MinHeight="74" MaxHeight="280" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="VPS线路列表">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" BorderBrush="#DCE4F0" Background="White" BorderThickness="1" Padding="13,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF2FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#527FFC"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#83A7EE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" ToolTip="{Binding Name}"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#233D60" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Region}" Foreground="#93A0B4" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding LocationTip}"><Image Source="{Binding Flag}" Width="25" Height="17" Stretch="Uniform" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding CountryDisplay}" Foreground="#617695" FontSize="12"/><TextBlock Text="{Binding LocationDisplay}" Foreground="#8D9BB1" FontSize="10" MaxWidth="155" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding Address}" FontFamily="Consolas" FontSize="12" Foreground="#587294" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Address}"/>
     <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="Ping/TCP 只表示网络探测，不等于问答可用。"><TextBlock Text="{Binding PingText}" Foreground="{Binding PingColor}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding LatencyText}" Foreground="{Binding LatencyColor}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
     <Button Grid.Column="4" Content="复制配置" Tag="{Binding}" Margin="6,0,0,0" ToolTip="复制这条线路的 frpc visitor TOML；包含私密连接密钥。" AutomationProperties.Name="复制此线路配置"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="选择后点击右上应用；复制不会切线。远端设备需连接同一 VPS。" Foreground="#8A97AB" FontSize="11" Margin="0,5,0,10"/>
   <Grid><StackPanel Orientation="Horizontal"><Button x:Name="CherryButton" Content="打开 Cherry Studio" Height="32" Margin="0,0,8,0"/><Button x:Name="WebButton" Content="打开网页版 ↗" Height="32"/><Button x:Name="RefreshButton" Content="↻ 刷新" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="ModelText" Text="默认模型读取中" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8A97AB" FontSize="11" MaxWidth="285" TextTrimming="CharacterEllipsis"/></Grid>
   <TextBox x:Name="History" Visibility="Collapsed"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" BorderBrush="#E1E7F1" BorderThickness="0,1,0,0" Background="#F8FAFD" Padding="22,10"><Grid><StackPanel Orientation="Horizontal"><Button x:Name="ConnectionButton" Content="连接信息" Style="{StaticResource LinkButton}"/><TextBlock Text="·" VerticalAlignment="Center" Foreground="#C2CCDA"/><Button x:Name="HistoryButton" Content="日志与记录" Style="{StaticResource LinkButton}"/><TextBlock Text="·" VerticalAlignment="Center" Foreground="#C2CCDA"/><Button x:Name="SettingsButton" Content="设置" Style="{StaticResource LinkButton}"/><Button x:Name="UpdateButton" Content="检查更新 ↗" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="CheckedAt" Text="关窗保留服务 · 1.1.0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#92A0B5"/></Grid></Border>
 </Grid>
</Window>
