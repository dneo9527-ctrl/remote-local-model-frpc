{
  "schema": 1,
  "geo": {
    "endpoint": "https://ipwho.is/",
    "fields": ["success", "country_code", "country", "region", "city"],
    "language": "zh-CN",
    "success_ttl_seconds": 604800,
    "failure_ttl_seconds": 300,
    "timeout_ttl_seconds": 30,
    "request_timeout_seconds": 2.5,
    "max_response_bytes": 16384
  }
}
